<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.PlantCare" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:navigationBarColor">#F0F4F0</item>

        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.PlantCare" parent="Base.Theme.PlantCare" />
    <style name="ShapeAppearance.App.Circle" parent="">
        <item name="cornerSize">50%</item>
    </style>
    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>
    <style name="BottomSheetTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">#00000000</item>
    </style>
    <style name="Theme.Transparent" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>