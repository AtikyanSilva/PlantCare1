<?xml version="1.0" encoding="utf-8"?>
<!-- item_chat_message.xml -->
<!-- Single chat bubble item; direction controlled in adapter via layoutDirection -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/messageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="12dp"
    android:gravity="top">

    <!-- Flora avatar (visible only for bot messages) -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp">

        <View
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/circle_bg_light_green" />

        <ImageView
            android:id="@+id/avatarIcon"
            android:layout_width="16dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_flora_mini" />
    </FrameLayout>

    <!-- Bubble + sender name -->
    <LinearLayout
        android:id="@+id/bubbleWrapper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="0">

        <!-- Sender label (only for Flora) -->
        <TextView
            android:id="@+id/senderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Флора"
            android:textSize="11sp"
            android:textColor="#1F6B3A"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="4dp" />

        <!-- Message text bubble -->
        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bubble_flora"
            android:textColor="#2D3436"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.6"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:maxWidth="240dp" />

        <!-- Quick reply chips (only for last bot message) -->
        <LinearLayout
            android:id="@+id/quickReplyContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/chip1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_quick_reply"
                android:textColor="#1F6B3A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="7dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chip2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_quick_reply"
                android:textColor="#1F6B3A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="7dp" />
        </LinearLayout>

        <!-- Typing indicator (three dots animation) -->
        <LinearLayout
            android:id="@+id/typingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bubble_flora"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:visibility="gone">

            <View android:id="@+id/dot1" android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/dot_typing" android:layout_marginEnd="4dp" />
            <View android:id="@+id/dot2" android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/dot_typing" android:layout_marginEnd="4dp" />
            <View android:id="@+id/dot3" android:layout_width="6dp" android:layout_height="6dp"
                android:background="@drawable/dot_typing" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
