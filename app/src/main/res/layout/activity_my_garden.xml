<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorMyGarden"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F3">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollMyGarden"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="88dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:id="@+id/layoutGardenHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F4F6F3"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvGardenUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Мой сад"
                        android:textColor="@color/text_dark"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvGardenStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 растений"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Аватарка — кликабельная, открывает профиль -->
                <ImageView
                    android:id="@+id/tvGardenEmoji"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle_white"
                    android:src="@drawable/avatar_gnome_green"
                    android:scaleType="centerCrop"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Профиль" />
            </LinearLayout>

            <!-- ЦИТАТА ДНЯ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardGardenQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#F0F4F0"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="14dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvGardenQuote"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="«Твои растения скучают без тебя! Загляни к монстере — она тянется к свету»"
                        android:textColor="@color/dark_green"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:lineSpacingMultiplier="1.3" />

                    <TextView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_circle_white"
                        android:gravity="center"
                        android:text="🌱"
                        android:textSize="18sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ЗАГОЛОВОК СЕКЦИИ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="10dp"
                android:text="МОИ РАСТЕНИЯ"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.12"
                android:textStyle="bold" />

            <!-- СЕТКА РАСТЕНИЙ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMyPlants"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- НАВБАР с FAB -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp">
                <ImageView
                    android:id="@+id/iconHome"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_home"
                    app:tint="#A0B5A4" />
                <TextView
                    android:id="@+id/labelHome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Главная"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#A0B5A4" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navInstruments"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp">
                <ImageView
                    android:id="@+id/iconInstruments"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_instruments"
                    app:tint="#A0B5A4" />
                <TextView
                    android:id="@+id/labelInstruments"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Инструменты"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#A0B5A4" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/navBotanist"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp">
                <ImageView
                    android:id="@+id/iconBotanist"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_botanist"
                    app:tint="#A0B5A4" />
                <TextView
                    android:id="@+id/labelBotanist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="AI Ботаник"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#A0B5A4" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/navGarden"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="6dp">
                <ImageView
                    android:id="@+id/iconGarden"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_garden"
                    app:tint="#1F6B3A" />
                <TextView
                    android:id="@+id/labelGarden"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Мой сад"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="#1F6B3A" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAddPlant"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_input_add"
            android:contentDescription="Добавить растение"
            app:backgroundTint="#1F6B3A"
            app:tint="@android:color/white"
            app:fabSize="mini"
            app:elevation="8dp"
            app:borderWidth="0dp"
            app:maxImageSize="22dp" />

    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
