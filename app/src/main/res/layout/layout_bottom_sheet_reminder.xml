<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_water_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="28dp">

    <!-- Ручка -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_water_handle"/>

    <!-- Заголовок -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔔 Напоминание о поливе"
        android:textColor="#0A4060"
        android:textSize="17sp"
        android:fontFamily="sans-serif-black"
        android:layout_marginBottom="16dp"/>

    <!-- Название растения -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌿 РАСТЕНИЕ"
        android:textColor="#2A8AB5"
        android:textSize="11sp"
        android:letterSpacing="0.07"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etPlantName"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_water_sheet_input"
        android:hint="Название растения"
        android:inputType="textCapSentences"
        android:paddingHorizontal="14dp"
        android:textColor="#0A4060"
        android:textColorHint="#80C0DE"
        android:textSize="14sp"/>

    <!-- День недели -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📅 ДЕНЬ НЕДЕЛИ"
        android:textColor="#2A8AB5"
        android:textSize="11sp"
        android:letterSpacing="0.07"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutTaskTypes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"/>
    </HorizontalScrollView>

    <!-- Время -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🕐 ВРЕМЯ"
        android:textColor="#2A8AB5"
        android:textSize="11sp"
        android:letterSpacing="0.07"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnSelectTime"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_water_sheet_time"
        android:text="Выбрать время"
        android:textColor="#2A8AB5"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"
        android:stateListAnimator="@null"/>

    <!-- Сохранить -->
    <Button
        android:id="@+id/btnSaveReminder"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_water_sheet_save"
        android:text="Сохранить"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:fontFamily="sans-serif-black"
        android:stateListAnimator="@null"/>

</LinearLayout>