<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F3"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="22dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_back_btn"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Назад"
                app:tint="#1D5C3D" />

        </RelativeLayout>

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Добавить напоминание"
                android:textColor="#122A16"
                android:textSize="26sp"
                android:fontFamily="sans-serif-black"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Мы напомним вам о важном деле "
                    android:textColor="#5C7260"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌿"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/ivLeafDecor"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Название"
                        android:textColor="#5C7260"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <EditText
                        android:id="@+id/etReminderName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="Например: Полив монстеры"
                        android:textColor="#122A16"
                        android:textColorHint="#C0CCBC"
                        android:textSize="15sp"
                        android:background="@null"
                        android:inputType="text"
                        android:maxLines="1" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivLeafDecor"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_reminder_leaf" />

            </RelativeLayout>

        </androidx.cardview.widget.CardView>

        
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Время"
                    android:textColor="#5C7260"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvSelectedTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="09:00"
                        android:textColor="#122A16"
                        android:textSize="28sp"
                        android:fontFamily="sans-serif-black"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/layoutTimePicker"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_clock_reminder"
                            app:tint="#2D7040" />

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_chevron_down"
                            app:tint="#9AAC90" />

                    </LinearLayout>

                </RelativeLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Дата и повторение"
                    android:textColor="#5C7260"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginBottom="14dp" />

                
                <LinearLayout
                    android:id="@+id/layoutRepeatToggle"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_toggle_container"
                    android:layout_marginBottom="18dp">

                    <TextView
                        android:id="@+id/tabRepeat"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Повторять"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@drawable/bg_tab_active"
                        android:textColor="#2D7040" />

                    <TextView
                        android:id="@+id/tabOnce"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Один раз"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:background="@null"
                        android:textColor="#9AAC90" />

                </LinearLayout>

                
                <LinearLayout
                    android:id="@+id/sectionRepeat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Повторять каждые"
                        android:textColor="#5C7260"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="18dp">

                        
                        <TextView
                            android:id="@+id/btnIntervalMinus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="−"
                            android:textSize="20sp"
                            android:textColor="#2D7040"
                            android:background="@drawable/bg_interval_btn" />

                        <TextView
                            android:id="@+id/tvIntervalValue"
                            android:layout_width="48dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="1"
                            android:textSize="18sp"
                            android:fontFamily="sans-serif-black"
                            android:textColor="#122A16"
                            android:textStyle="bold" />

                        
                        <TextView
                            android:id="@+id/btnIntervalPlus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:text="+"
                            android:textSize="20sp"
                            android:textColor="#2D7040"
                            android:background="@drawable/bg_interval_btn" />

                        
                        <LinearLayout
                            android:id="@+id/layoutPeriodPicker"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginStart="12dp"
                            android:background="@drawable/bg_period_picker"
                            android:paddingHorizontal="12dp">

                            <TextView
                                android:id="@+id/tvPeriodLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="неделя"
                                android:textSize="14sp"
                                android:textColor="#122A16"
                                android:fontFamily="sans-serif-medium" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="4dp"
                                android:src="@drawable/ic_chevron_down"
                                app:tint="#9AAC90" />

                        </LinearLayout>

                    </LinearLayout>

                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="В дни"
                        android:textColor="#5C7260"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="10dp" />

                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/chipMon"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_day_chip"
                            android:gravity="center"
                            android:text="Пн"
                            android:textSize="12sp"
                            android:textColor="@drawable/day_chip_text_color"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/chipTue"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_day_chip"
                            android:gravity="center"
                            android:text="Вт"
                            android:textSize="12sp"
                            android:textColor="@drawable/day_chip_text_color"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/chipWed"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_day_chip"
                            android:gravity="center"
                            android:text="Ср"
                            android:textSize="12sp"
                            android:textColor="@drawable/day_chip_text_color"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/chipThu"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_day_chip"
                            android:gravity="center"
                            android:text="Чт"
                            android:textSize="12sp"
                            android:textColor="@drawable/day_chip_text_color"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/chipFri"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_day_chip"
                            android:gravity="center"
                            android:text="Пт"
                            android:textSize="12sp"
                            android:textColor="@drawable/day_chip_text_color"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/chipSat"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_day_chip"
                            android:gravity="center"
                            android:text="Сб"
                            android:textSize="12sp"
                            android:textColor="@drawable/day_chip_text_color"
                            android:fontFamily="sans-serif-medium" />

                        <TextView
                            android:id="@+id/chipSun"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_day_chip"
                            android:gravity="center"
                            android:text="Вс"
                            android:textSize="12sp"
                            android:textColor="@drawable/day_chip_text_color"
                            android:fontFamily="sans-serif-medium" />

                    </LinearLayout>

                    
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_centerVertical="true"
                            android:background="#E0E8DE" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:background="#FFFFFF"
                            android:paddingHorizontal="10dp"
                            android:text="или"
                            android:textColor="#9AAC90"
                            android:textSize="12sp" />

                    </RelativeLayout>

                    
                    <LinearLayout
                        android:id="@+id/layoutSpecificDates"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_dates_row"
                        android:paddingHorizontal="14dp"
                        android:layout_marginBottom="2dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_calendar_reminder"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/tvSelectedDatesLabel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Выбрано: 0 дат"
                            android:textColor="#5C7260"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#9AAC90" />

                    </LinearLayout>

                </LinearLayout>

                
                <LinearLayout
                    android:id="@+id/sectionOnce"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Дата"
                        android:textColor="#5C7260"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout
                        android:id="@+id/layoutOnceDate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_dates_row"
                        android:paddingHorizontal="14dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_calendar_reminder"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:id="@+id/tvOnceDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Выберите дату"
                            android:textColor="#5C7260"
                            android:textSize="14sp" />

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#9AAC90" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:id="@+id/layoutStartDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Начало"
                        android:textColor="#5C7260"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvStartDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Сегодня"
                        android:textColor="#122A16"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_calendar_reminder"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#9AAC90" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="28dp"
            android:visibility="gone"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:id="@+id/layoutReminderAdvance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Напоминание"
                        android:textColor="#5C7260"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />

                    <TextView
                        android:id="@+id/tvReminderAdvance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="За 10 минут"
                        android:textColor="#122A16"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:src="@drawable/ic_clock_reminder"
                    app:tint="#2D7040"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#9AAC90" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        
        <Button
            android:id="@+id/btnSaveReminder"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/btn_save_reminder"
            android:backgroundTint="@null"
            android:text="Сохранить напоминание"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

    </LinearLayout>

</ScrollView>
