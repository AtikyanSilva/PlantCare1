<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/rounded_dialog_bg"
    android:paddingBottom="24dp">

    <ImageView
        android:id="@+id/dialogImage"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#122A16" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_dialog_info"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" О проблеме" android:textStyle="bold" android:textColor="#1D5C3D"/>
    </LinearLayout>

    <TextView
        android:id="@+id/dialogDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:textColor="#5C7260" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:layout_marginTop="16dp">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_menu_edit"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Как бороться" android:textStyle="bold" android:textColor="#1D5C3D"/>
    </LinearLayout>

    <TextView
        android:id="@+id/dialogTreatment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:textColor="#5C7260" />

</LinearLayout>